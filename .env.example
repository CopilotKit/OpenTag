# ── Intelligence Channel host (`pnpm channel`) ─────────────────────────
# Both variables are required. The local Python agent listens on :8123.
AGENT_URL=http://localhost:8123/
INTELLIGENCE_API_KEY=cpk-...

# Production defaults; override only for another Intelligence environment.
# INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
# INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
# Base Channel name. OpenTag declares this Slack Channel plus a Teams Channel
# suffixed with "-teams". Railway sets the base to "kite".
# INTELLIGENCE_CHANNEL_NAME=opentag
# HTTP port for the CopilotRuntime listener. Defaults to 3000.
# PORT=3000
# Optional authorization header forwarded to the AG-UI agent.
# AGENT_AUTH_HEADER=Bearer ...

# Slack and Microsoft Teams credentials belong in CopilotKit Intelligence, not
# this runtime environment. Discord, Telegram, and WhatsApp are coming soon.

# ── Python deep-research agent (`pnpm agent`) ───────────────────────────
# The Python service also loads this root .env during local development.
OPENAI_API_KEY=sk-...
# Optional live web research. Without Tavily the agent still chats, plans,
# uses its virtual filesystem, and renders UI components.
# TAVILY_API_KEY=tvly-...
# OPENAI_MODEL=gpt-5.5
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8123

# ── Internal research sources (optional) ────────────────────────────────
# LINEAR_API_KEY=lin_api_...
# LINEAR_MCP_URL=https://mcp.linear.app/mcp

# The Notion MCP sidecar is local-only and not a Railway service.
# NOTION_TOKEN=ntn_...
# NOTION_MCP_AUTH_TOKEN=choose-a-strong-shared-secret
# NOTION_MCP_URL=http://127.0.0.1:3001/mcp
# NOTION_MCP_PORT=3001
