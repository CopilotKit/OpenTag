# -- Intelligence Variables --
# Get an API key at https://intelligence.copilotkit.ai.
# Both variables are required. The included agent listens on port 8123.
AGENT_URL=http://localhost:8123/
INTELLIGENCE_API_KEY=cpk-...

# Optional. Defaults to "opentag"; production uses "kite".
# INTELLIGENCE_CHANNEL_NAME=opentag

# -- Agent Variables --
# Get an API key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-...

# Optional web research and model override.
# TAVILY_API_KEY=tvly-...
# OPENAI_MODEL=gpt-5.5

# -- Internal Sources (Optional) --
# LINEAR_API_KEY=lin_api_...
# NOTION_TOKEN=ntn_...
# NOTION_MCP_AUTH_TOKEN=choose-a-shared-secret
